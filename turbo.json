{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env",
    "scripts/package-standalone.ts",
    "contracts/openapi.json",
    "contracts/openapi.lock.json"
  ],
  "globalEnv": ["NEXT_PUBLIC_*"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "start": {
      "passThroughEnv": [
        "PORT",
        "HOSTNAME",
        "KEEP_ALIVE_TIMEOUT",
        "NODE_OPTIONS"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "cache": false
    }
  }
}
