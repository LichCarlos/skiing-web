    {
      "title": "新增字典项",
      "width": 1440,
      "items": [
        {
          "label": "名称",
          "hint": "选项显示给用户的文字，如“停车场”，最多100字。",
          "fontSize": "13px",
          "color": "rgb(73, 94, 128)",
          "fits": true,
          "describedBy": "label_extra",
          "extraId": "label_extra"
        },
        {
          "label": "值",
          "hint": "实际保存和引用的值，如 parking；修改前请核对已有业务引用。",
          "fontSize": "13px",
          "color": "rgb(73, 94, 128)",
          "fits": true,
          "describedBy": "value_extra",
          "extraId": "value_extra"
        },
        {
          "label": "父级",
          "hint": "选择所属上级以建立层级；留空表示根节点，不能选择自己或自己的子级。",
          "fontSize": "13px",
          "color": "rgb(73, 94, 128)",
          "fits": true,
          "describedBy": "parentId_extra",
          "extraId": "parentId_extra"
        },
        {
          "label": "颜色",
          "hint": "可选的选项标识色，如 #2455F5；留空不指定颜色。",
          "fontSize": "13px",
          "color": "rgb(73, 94, 128)",
          "fits": true,
          "describedBy": "color_extra",
          "extraId": "color_extra"
        },
        {
          "label": "排序",
          "hint": "控制同级选项的展示顺序，数值较小的优先。",
          "fontSize": "13px",
          "color": "rgb(73, 94, 128)",
          "fits": true,
          "describedBy": "sortOrder_extra",
          "extraId": "sortOrder_extra"
        },
        {
          "label": "默认项",
          "hint": "标记为默认候选项，具体是否预选由使用该字典的表单决定。",
          "fontSize": "13px",
          "color": "rgb(73, 94, 128)",
          "fits": true,
          "describedBy": "isDefault_extra",
          "extraId": "isDefault_extra"
        }
      ]
    },
