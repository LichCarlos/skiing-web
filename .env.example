# 复制为本仓库根目录的 .env。API 地址指向独立部署的 NestJS 服务。
# NEXT_PUBLIC_* 都是可公开信息，会固化在浏览器构建产物中。
NEXT_PUBLIC_WEB_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:8080/api/v1
# 可选：官网实际公开 origin（无路径/查询/片段）。未配置时不生成 canonical/og:url。
NEXT_PUBLIC_WEB_SITE_ORIGIN=
# 如需服务端专用变量，请勿使用 NEXT_PUBLIC_ 前缀。

# Build-time path prefixes; empty for root deployment.
NEXT_PUBLIC_WEB_BASE_PATH=
NEXT_PUBLIC_ADMIN_BASE_PATH=
