{
  "name": "frontend-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "dev:web": "node scripts/run.mjs dev --filter=@common/web",
    "dev:admin": "node scripts/run.mjs dev --filter=@common/admin",
    "build": "node scripts/run.mjs build",
    "build:web": "node scripts/run.mjs build --filter=@common/web...",
    "build:admin": "node scripts/run.mjs build --filter=@common/admin...",
    "start:web": "node scripts/run.mjs start --filter=@common/web",
    "start:admin": "node scripts/run.mjs start --filter=@common/admin",
    "lint": "node scripts/run.mjs lint",
    "typecheck": "node scripts/run.mjs typecheck && pnpm typecheck:ai-browser && pnpm typecheck:release",
    "typecheck:release": "tsc -p scripts/tsconfig.release.json",
    "package:web": "node --experimental-strip-types scripts/package-standalone.ts pack web",
    "package:admin": "node --experimental-strip-types scripts/package-standalone.ts pack admin",
    "release:verify": "node --experimental-strip-types scripts/package-standalone.ts verify",
    "test:release": "node --experimental-strip-types --test --test-concurrency=1 scripts/package-standalone.test.ts",
    "source:export": "node --experimental-strip-types scripts/export-source.ts",
    "test:source-export": "node --experimental-strip-types --test --test-concurrency=1 scripts/export-source.node-test.ts",
    "typecheck:ai-browser": "tsc -p scripts/tsconfig.browser.json",
    "openapi:generate": "openapi-typescript contracts/openapi.json -o packages/api-contracts/src/openapi.ts",
    "openapi:verify": "node scripts/verify-openapi.mjs && openapi-typescript --check contracts/openapi.json -o packages/api-contracts/src/openapi.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:api-client": "vitest run packages/api-contracts/src/client.test.ts",
    "test:admin-permissions": "vitest run --config apps/admin/vitest.config.ts apps/admin/src/features/permissions/",
    "test:admin-auth": "vitest run --config apps/admin/vitest.config.ts apps/admin/src/features/auth/ apps/admin/src/platform/auth/",
    "test:admin-users": "vitest run --config apps/admin/vitest.config.ts apps/admin/src/features/users/",
    "test:admin-roles": "vitest run --config apps/admin/vitest.config.ts apps/admin/src/features/roles/",
    "test:admin-articles": "vitest run --config apps/admin/vitest.config.ts apps/admin/src/features/articles/",
    "test:admin-assets": "vitest run --config apps/admin/vitest.config.ts apps/admin/src/features/assets/",
    "test:merchant-resorts": "vitest run --config apps/admin/vitest.config.ts apps/admin/src/features/merchant-resorts/ apps/admin/src/features/admin-resorts/",
    "test:web-home": "vitest run --config apps/web/vitest.config.ts apps/web/src/features/home/",
    "test:web-ai": "vitest run --config apps/web/vitest.config.ts apps/web/src/features/ai/ apps/web/src/platform/api/stream.test.ts",
    "test:web-metadata": "vitest run --config apps/web/vitest.config.ts apps/web/src/features/public-content/public-metadata.test.ts",
    "test:route-state": "vitest run --config apps/web/vitest.config.ts apps/web/src/features/route-state/ && vitest run --config apps/admin/vitest.config.ts apps/admin/src/features/route-state/",
    "test:web-public-http": "vitest run --config apps/web/vitest.config.public-http.ts",
    "check": "pnpm openapi:verify && pnpm check:boundaries && pnpm lint && pnpm typecheck && pnpm test:api-client && pnpm test:api-initialization && pnpm test:route-state && pnpm test:admin-permissions && pnpm test:admin-auth && pnpm test:admin-ai-operations && pnpm test:admin-users && pnpm test:admin-roles && pnpm test:admin-dictionaries && pnpm test:admin-fields && pnpm test:admin-articles && pnpm test:admin-project-knowledge && pnpm test:admin-community && pnpm test:admin-assets && pnpm test:merchant-resorts && pnpm test:admin-events && pnpm test:admin-operation-logs && pnpm test:admin-revenue && pnpm test:merchant-dashboard && pnpm test:web-home && pnpm test:web-ai && pnpm test:web-metadata && pnpm test:web-resorts && pnpm test:web-knowledge && pnpm test:web-community && pnpm test:web-article-favorites && pnpm test:system-config && pnpm test:release && pnpm test:source-export && pnpm format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:boundaries": "node --test scripts/check-boundaries.test.mjs",
    "test:admin-operation-logs": "vitest run --config apps/admin/vitest.config.ts apps/admin/src/features/operation-logs/",
    "test:admin-ai-operations": "vitest run --config apps/admin/vitest.config.ts apps/admin/src/features/ai-operations/",
    "test:ai-browser": "node --experimental-strip-types --test --test-concurrency=1 scripts/ai-operations-browser.ts",
    "test:password-browser": "node --experimental-strip-types --test --test-concurrency=1 scripts/password-reset-browser.ts",
    "test:independent-browser": "node --experimental-strip-types --test --test-concurrency=1 scripts/independent-start-browser.ts",
    "test:admin-revenue": "vitest run --config apps/admin/vitest.config.ts apps/admin/src/features/revenue/",
    "test:admin-events": "vitest run --config apps/admin/vitest.config.ts apps/admin/src/features/events/",
    "test:web-article-favorites": "vitest run --config apps/web/vitest.config.ts apps/web/src/features/article-favorites/ apps/web/src/platform/auth/",
    "test:system-config": "vitest run --config apps/admin/vitest.config.ts apps/admin/src/features/system-config/ && vitest run --config apps/web/vitest.config.ts apps/web/src/features/site-config/",
    "test:merchant-dashboard": "vitest run --config apps/admin/vitest.config.ts apps/admin/src/features/merchant-dashboard/ apps/admin/src/features/dashboard/",
    "test:web-resorts": "vitest run --config apps/web/vitest.config.ts apps/web/src/features/resorts/ apps/web/src/features/catalog/",
    "test:api-initialization": "vitest run --config apps/web/vitest.config.ts apps/web/src/platform/api/index.test.ts && vitest run --config apps/admin/vitest.config.ts apps/admin/src/platform/api/index.test.ts",
    "test:web-knowledge": "vitest run --config apps/web/vitest.config.ts apps/web/src/features/knowledge/",
    "test:web-community": "vitest run --config apps/web/vitest.config.ts apps/web/src/features/community/",
    "test:admin-dictionaries": "vitest run --config apps/admin/vitest.config.ts apps/admin/src/features/dictionaries/",
    "test:admin-fields": "vitest run --config apps/admin/vitest.config.ts apps/admin/src/features/custom-fields/",
    "test:admin-project-knowledge": "vitest run --config apps/admin/vitest.config.ts apps/admin/src/features/project-knowledge/",
    "test:admin-community": "vitest run --config apps/admin/vitest.config.ts apps/admin/src/features/community/",
    "test:admin-authorization-http": "vitest run --config apps/admin/vitest.config.authorization-http.ts",
    "test:revenue-recovery-http": "vitest run --config apps/admin/vitest.config.revenue-http.ts",
    "source:verify": "node --experimental-strip-types scripts/export-source.ts --verify"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "openapi-typescript": "7.13.0",
    "playwright": "1.62.1",
    "prettier": "3.9.9",
    "turbo": "2.11.2",
    "typescript": "5.9.3",
    "vitest": "4.1.2"
  }
}
